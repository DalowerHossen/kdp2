# KD SOLUTION IT - environment template
# Every key the platform reads is documented here. Copy to .env.local for local work.
# Rule: secrets live only here (or in the platform secret store), never in the database.

# --- Application ---
# Public base URL of the deployment, used for absolute links in emails and receipts.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Runtime environment: development | test | production
NODE_ENV=development

# Log level for the structured logger: debug | info | warn | error
LOG_LEVEL=info

# --- Supabase (text and numeric data always live in Supabase Postgres, Rule 3) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Server-only. Service role bypasses RLS; use ONLY through lib/supabase/admin.ts
# together with withTenantContext() from lib/supabase/rls-helpers.ts.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Direct Postgres connection string (session pooler) for migrations and server queries.
# Used by scripts/migrate.mjs and lib/db/client.ts on the server runtime.
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# --- Cryptography ---
# 64 hex chars (32 bytes). Root key for the AES-256-GCM vault (files, TOTP secrets,
# stored credentials). Per-tenant keys are derived from tenant_id + this master key
# and are never stored in plaintext. Generate: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=replace-with-64-hex-chars

# --- Observability (optional; code must run without them) ---
# Sentry DSN. When absent, errors go to the JSON logger only. PII scrubbing is mandatory.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- Location allow-list (optional) ---
# Comma-separated ISO country codes from which admin surfaces may be reached.
ADMIN_GEO_ALLOWLIST=
