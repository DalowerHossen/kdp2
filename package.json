{
  "name": "kd-solution-it",
  "version": "0.0.1",
  "private": true,
  "description": "KD SOLUTION IT - enterprise multi-tenant SaaS platform",
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.2.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "bash scripts/check-english-only.sh && bash scripts/check-money-types.sh && bash scripts/check-path-comment.sh && bash scripts/check-forbidden-tokens.sh && bash scripts/check-no-test-files.sh && bash scripts/check-forbidden-brands.sh",
    "verify-db": "node scripts/verify-db.mjs",
    "verify-rls": "node scripts/verify-rls.mjs",
    "check-boundaries": "bash scripts/check-step-boundaries.sh",
    "migrate": "node scripts/migrate.mjs up",
    "migrate:down": "node scripts/migrate-down.mjs",
    "manifest": "node scripts/build-feature-manifest.mjs",
    "tokens": "node scripts/build-design-tokens.mjs",
    "tokens:check": "node scripts/build-design-tokens.mjs --check",
    "coverage": "bash scripts/check-feature-coverage.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.45.4",
    "clsx": "2.1.1",
    "decimal.js": "10.4.3",
    "lucide-react": "0.454.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.17",
    "@types/node": "22.9.0",
    "@types/pg": "8.11.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.13.0",
    "@typescript-eslint/parser": "8.13.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "husky": "9.1.6",
    "pg": "8.13.1",
    "postcss": "8.4.47",
    "prettier": "3.3.3",
    "tailwind-merge": "2.5.4",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3"
  }
}
